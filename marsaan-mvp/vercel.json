{
  "functions": {
    "api/admin/leads.js": {
      "maxDuration": 60
    },
    "api/admin/sourcing.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}