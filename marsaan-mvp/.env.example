# Vercel Environment Variables (Project → Settings → Environment Variables)

# === Email (Zoho Mail SMTP is simplest) ===
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=rfq@marsaan.com
SMTP_PASS=your_zoho_app_password_or_mailbox_password

# Where you want RFQ notifications to arrive
MAIL_TO=rfq@marsaan.com

# Optional (defaults to SMTP_USER)
MAIL_FROM=rfq@marsaan.com

# Optional: maximum BOM upload size (bytes)
RFQ_MAX_FILE_BYTES=8000000

# === Optional CRM/Lead pipeline webhook (Zoho Flow / Odoo / Make / Zapier) ===
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# === RFQ persistence (Supabase) ===
# Optional but recommended: without these, RFQs are still emailed exactly
# as before, just not saved anywhere. Get these from your Supabase project
# at Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is a secret — never put it in frontend code,
# only in Vercel's server-side environment variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Admin dashboard (/admin) ===
# ADMIN_PASSWORD: the single shared password to log into /admin.
# Pick something long and random — this is the only thing standing
# between the public internet and your RFQ data.
# ADMIN_SESSION_SECRET: a separate random string used to sign login
# sessions. Generate one with: openssl rand -hex 32
# Both are required for /admin to work at all — without them, /admin
# will show a 500 error on login rather than silently failing open.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
